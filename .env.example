# Public site URL (for canonical/sitemap/llms.txt). Production domain:
BASE_URL=https://llmlatency.dev

# Region of this probe VPS (one per instance). "local" for debugging.
REGION=local

# Path to the time-series file.
DB_PATH=measurements.db

# Timeout for a single network operation, seconds.
PROBE_TIMEOUT=10

# Node mode: all = probe + build + prune (central/single-node), probe = probe only (remote node)
MODE=all

# Retention: raw samples older than N days are deleted (bounds the central node's disk)
RETENTION_DAYS=90

# --- Phase 2 (multi-region) ---
# On a probe node: where to ship measurements + token (same as the ingest endpoint).
INGEST_URL=https://ingest.example.com/ingest
INGEST_TOKEN=
# On the central node (ingest): port (behind a reverse proxy) + the same token.
INGEST_PORT=8787

# Keys for inference probes (real TTFT). Without them, only network probes run.
# Only fill in the providers you actually want to measure by TTFT.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
MISTRAL_API_KEY=
DEEPSEEK_API_KEY=
XAI_API_KEY=
OPENROUTER_API_KEY=
